# Mako notification daemon configuration.

# Colors are generated by pywal16 and regenerated on wallpaper change.
# The included file sets background-color, text-color, and border-color.
# Reload after a wallpaper change with: makoctl reload
include=~/.cache/wal/colors-mako

# --- Appearance ---
font=monospace 10
width=360
height=160
margin=10
padding=12
border-size=2
border-radius=8

# --- Icons ---
icons=1
max-icon-size=48

# --- Text ---
markup=1
format=<b>%s</b>\n%b

# --- Behavior ---
default-timeout=5000
ignore-timeout=0
sort=-time
group-by=app-name
max-visible=5
layer=overlay
anchor=top-right
