theme = purple
font-size = 13
font-family = Hack Nerd
background-blur-radius = 20
background-opacity = 0.825

window-decoration = true
window-padding-x = 4
window-padding-y = 4

term = xterm-256color

mouse-hide-while-typing = true
cursor-style = block
cursor-style-blink = false

# this needs to be set to make the cursor work in insert mode
shell-integration-features = no-cursor

# global keybind to open the popup/dropdown terminal
keybind = global:ctrl+shift+o=toggle_quick_terminal
keybind = global:ctrl+shift+g=new_window

# general window controls
keybind = ctrl+s>r=reload_config
keybind = ctrl+s>x=close_surface
keybind = ctrl+s>n=new_window

# controlling splits or panes
keybind = ctrl+s>/=new_split:right
keybind = ctrl+s>-=new_split:down
keybind = ctrl+s>k=goto_split:top
keybind = ctrl+s>j=goto_split:bottom
keybind = ctrl+s>h=goto_split:left
keybind = ctrl+s>l=goto_split:right
keybind = ctrl+s>z=toggle_split_zoom
keybind = ctrl+s>e=equalize_splits

# controll tabs
keybind = ctrl+t=new_tab
