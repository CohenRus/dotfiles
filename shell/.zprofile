# syntax highlighing color for bat file preview
export BAT_THEME=OneHalfDark

export NONE=1

# stuff to make nvim work as default cl editor
export VISUAL="$EDITOR"

# for custom cohdoo github stuff
export GIT_EMAIL="cohen_russell@icloud.com"
export GIT_EMAIL_ALT="cohdoo.team@gmail.com"

# path for starship config file
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
