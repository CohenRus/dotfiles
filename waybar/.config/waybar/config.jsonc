{
  "layer": "top",
  "position": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "margin": "5, 5, 0, 5",

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock",
    "custom/spotify"
  ],
  "modules-right": [
    "tray",
    "bluetooth",
    "pulseaudio",
    "power-profiles-daemon",
    "battery",
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "tooltip": false,
    "all-outputs": false,
    "sort-by-number": true,
    "disable-scroll": false,
    "on-scroll-up": "hyprctl dispatch workspace +1",
    "on-scroll-down": "hyprctl dispatch workspace -1",
    "show-special": false
  },

  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-connected": "󰂱",
    "format-off": "",
    "format-disabled": "",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth: {status}",
    "on-click": "blueman-manager"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "tooltip-format": "Volume: {volume}%",
    "format-icons": ["", "", ""],
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "battery": {
    "interval": 60,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% — {timeTo}",
    "format-time": "{H}h {M}m"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "icons": {
      "nm-applet": "/home/cohen/.config/waybar/wifi.svg"
    }
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Profile: {profile}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "clock": {
    "format": "{:%m/%d %H:%M}",
    "format-alt": "{:%A, %B %d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#c4a7e7'><b>{}</b></span>",
        "days": "<span color='#e0def4'><b>{}</b></span>",
        "weeks": "<span color='#6e6a86'><b>W{}</b></span>",
        "weekdays": "<span color='#9ccfd8'><b>{}</b></span>",
        "today": "<span color='#eb6f92'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "wlogout"
  },

  "custom/spotify": {
    "exec": "/usr/bin/python3 /home/cohen/Work/scripts/waybar-spotify.py --player spotify",
    "format": "{}",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  }
}
